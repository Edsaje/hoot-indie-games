# Interdire le listage des répertoires
Options -Indexes

# Interdire l'accès direct aux fichiers sensibles, fichiers cachés et sauvegardes
<FilesMatch "(^\..*|\.json|\.secret|\.steam_key|\.admin_pass|\.log|\.env|\.bak|\.tmp.*|\.tmp|\.swp|\.swo|~$|\.php\.bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^tracker/?$ track.php [L,QSA]
    RewriteRule ^track/?$ track.php [L,QSA]
</IfModule>

# Protection anti-cache Cloudflare / CDN pour l'ensemble des endpoints API dynamiques
<IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</IfModule>


