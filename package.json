{
  "name": "hoot-indie-games",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "prebuild": "npx tsx scripts/generateSeoIndex.ts",
    "generate-seo": "npx tsx scripts/generateSeoIndex.ts",
    "generate-og": "npx tsx scripts/generateOgBanner.ts",
    "generate-linkedin": "npx tsx scripts/generateLinkedinBanner.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:php": "php tests/run_php_tests.php 2>/dev/null || docker run --rm -u $(id -u):$(id -g) -v $(pwd):/app -w /app php:8.3-cli php tests/run_php_tests.php",
    "test:all": "npm run lint && npm run test && npm run test:php",
    "preview": "vite preview",
    "add-game": "npx tsx scripts/fetchSteamGame.ts",
    "update-db": "npx tsx scripts/addBatchGames.ts && npx tsx scripts/mergeGamesDatabase.ts",
    "audit-db": "npx tsx scripts/verifySteamDatabase.ts",
    "audit-cards": "npx tsx scripts/auditGemsCardsSync.ts",
    "audit-links": "npx tsx scripts/auditExternalLinks.ts",
    "harvest-daily": "npx tsx scripts/dailyIndieHarvest.ts",
    "harvest-massive": "npx tsx scripts/harvestMassiveCatalog.ts",
    "sync-odyssey": "npx tsx scripts/syncOdysseyRoutes.ts",
    "sync-store": "npx tsx scripts/syncSteamStoreData.ts",
    "fetch-steam": "npx tsx scripts/fetchSteamCatalog.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.14",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
